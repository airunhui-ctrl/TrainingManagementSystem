# Copy to .env.docker on the server. Never commit .env.docker.
POSTGRES_DB=training_management
POSTGRES_USER=training_app
POSTGRES_PASSWORD=change-this-database-password

NODE_ENV=staging
PORT=3100
# Inside Compose, postgres is the service hostname, not 127.0.0.1.
DATABASE_URL=postgresql://training_app:change-this-database-password@postgres:5432/training_management?schema=public
UPLOAD_DIR=/app/backend/api/storage/payment-proofs
JWT_SECRET=replace-with-a-new-random-secret-at-least-32-characters
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=14d
MAX_UPLOAD_BYTES=5242880

# Internal test only. Switch to real production channels after HTTPS callbacks are ready.
WECHAT_ADAPTER=fake
WECHAT_LOGIN_SCENE=mini_program
PASSWORD_RESET_ADAPTER=fake
PAYMENT_ADAPTER=disabled
