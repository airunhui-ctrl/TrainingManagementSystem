# Copy to .env.docker on the target server, then replace every placeholder.
# Never commit .env.docker or put real secrets in this template.
NODE_ENV=staging
POSTGRES_DB=training_management
POSTGRES_USER=training_app
POSTGRES_PASSWORD=change-this-database-password
DATABASE_URL=postgresql://training_app:change-this-database-password@postgres:5432/training_management?schema=public
JWT_SECRET=replace-with-a-new-random-secret-at-least-32-characters
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=14d
UPLOAD_DIR=storage/payment-proofs
MAX_UPLOAD_BYTES=5242880
INVOICE_UPLOAD_MAX_BYTES=10485760
PAYMENT_ADAPTER=disabled

# Internal non-payment testing defaults. Configure controlled webhooks separately
# before any production-like password or phone delivery workflow.
PASSWORD_RESET_ADAPTER=fake
PHONE_REGISTRATION_ADAPTER=fake
