# Copy to .env.docker on the target server, then replace every placeholder.
# Never commit .env.docker or put real secrets in this template.
NODE_ENV=staging
POSTGRES_DB=training_management
POSTGRES_USER=training_app
POSTGRES_PASSWORD=change-this-database-password
DATABASE_URL=postgresql://training_app:change-this-database-password@postgres:5432/training_management?schema=public
JWT_SECRET=replace-with-a-new-random-secret-at-least-32-characters
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=14d
UPLOAD_DIR=storage/payment-proofs
MAX_UPLOAD_BYTES=5242880
INVOICE_UPLOAD_MAX_BYTES=10485760
PAYMENT_ADAPTER=disabled

# 微信小程序一键授权登录；正式环境改为 real 并填写小程序 AppID/AppSecret
WECHAT_ADAPTER=fake
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# Internal non-payment testing defaults. Configure controlled webhooks separately
# before any production-like password or phone delivery workflow.
PASSWORD_RESET_ADAPTER=fake
PHONE_REGISTRATION_ADAPTER=fake

# 阿里云短信（注册与找回密码共用 AccessKey/签名；模板可分开）
PHONE_REGISTRATION_WEBHOOK_URL=
PHONE_REGISTRATION_WEBHOOK_TOKEN=
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_REGION_ID=cn-hangzhou
ALIYUN_SMS_ENDPOINT=dysmsapi.aliyuncs.com
ALIYUN_SMS_TEMPLATE_CODE_REGISTRATION=
ALIYUN_SMS_TEMPLATE_CODE_PASSWORD_RESET=

# 星驿付 JSAPI 联调/生产参数；real 时 PAYMENT_CHANNEL_POSTAR 必须为 1
PAYMENT_CHANNEL_POSTAR=
XYPAY_BASE_URL=https://xyf-server-test.postar.cn
XYPAY_AGET_ID=
XYPAY_CUST_ID=
XYPAY_PUBLIC_KEY=
XYPAY_PUBLIC_KEY_FILE=
XYPAY_NOTIFY_URL=https://kch5.lbx.fj.cn/api/payments/postar/notify