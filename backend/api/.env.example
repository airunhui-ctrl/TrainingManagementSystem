NODE_ENV=development
PORT=3100
DATABASE_FILE=./data/training.db
UPLOAD_DIR=./storage/payment-proofs
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=14d
MAX_UPLOAD_BYTES=5242880

# 外部渠道适配器：development 可用 fake；production 必须显式 real 或 disabled
WECHAT_ADAPTER=fake
WECHAT_APP_ID=
WECHAT_APP_SECRET=
PAYMENT_ADAPTER=disabled
WECHAT_PAY_MCH_ID=
ALIPAY_APP_ID=
