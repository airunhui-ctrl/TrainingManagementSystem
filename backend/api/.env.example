NODE_ENV=development
PORT=3100
DATABASE_FILE=./data/training.db
# PostgreSQL deployment: unset DATABASE_FILE and set DATABASE_URL instead, for example:
# DATABASE_URL=postgresql://training_app:change-me@127.0.0.1:5432/training_management?schema=public
UPLOAD_DIR=./storage/payment-proofs
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=14d
MAX_UPLOAD_BYTES=5242880

# 外部渠道适配器：development 可用 fake；production 必须显式 real 或 disabled
WECHAT_ADAPTER=fake
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# mini_program / h5 / official_account；前端请求也可通过 scene 显式指定
WECHAT_LOGIN_SCENE=mini_program
PAYMENT_ADAPTER=disabled
WECHAT_PAY_MCH_ID=
WECHAT_PAY_APP_ID=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_PRIVATE_KEY_FILE=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PLATFORM_CERTIFICATE=
WECHAT_PAY_PLATFORM_CERTIFICATE_FILE=
WECHAT_PAY_NOTIFY_URL=
# h5 / native / jsapi（jsapi 需要当前账号已绑定小程序 openid）
WECHAT_PAY_PRODUCT=h5
WECHAT_PAY_H5_TYPE=Wap
WECHAT_PAY_CLIENT_IP=127.0.0.1
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PRIVATE_KEY_FILE=
ALIPAY_PUBLIC_KEY=
ALIPAY_PUBLIC_KEY_FILE=
ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL=

# 密码找回渠道：development 使用 fake 仅返回内部测试验证码；production 必须使用 webhook 或 disabled
PASSWORD_RESET_ADAPTER=fake
PASSWORD_RESET_SECRET=
PASSWORD_RESET_WEBHOOK_URL=
PASSWORD_RESET_WEBHOOK_TOKEN=

# 手机号注册短信渠道：development 使用 fake；production 使用 aliyun/webhook/disabled
PHONE_REGISTRATION_ADAPTER=fake
PHONE_REGISTRATION_WEBHOOK_URL=
PHONE_REGISTRATION_WEBHOOK_TOKEN=

# 阿里云短信（注册与找回密码共用 AccessKey/签名；模板可分开）
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_REGION_ID=cn-hangzhou
ALIYUN_SMS_ENDPOINT=dysmsapi.aliyuncs.com
ALIYUN_SMS_TEMPLATE_CODE_REGISTRATION=
ALIYUN_SMS_TEMPLATE_CODE_PASSWORD_RESET=
