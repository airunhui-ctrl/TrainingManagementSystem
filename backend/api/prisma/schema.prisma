generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                   String           @id
  username             String           @unique
  usernameNormalized   String?
  passwordHash         String
  role                 String           @default("user")
  name                 String?
  company              String?
  avatarText           String?
  phone                String?          @unique
  gender               String?
  email                String?
  wechatOpenId         String?
  agreementVersion     String?
  agreementAcceptedAt  DateTime?
  lastLoginAt          DateTime?
  registeredAt         DateTime         @default(now())
  enabled              Boolean          @default(true)
  sessionVersion       Int              @default(0)
  points               Int              @default(0)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  refreshTokens        RefreshToken[]
  orders               Order[]
  invoices             Invoice[]
  previews             Preview[]
  feedbacks            Feedback[]
  pointLedgers         PointLedger[]
  messageReads         MessageRead[]
  accountStudents      AccountStudent[]
  enrollmentsAsAccount Enrollment[]     @relation("EnrollmentAccountUser")
  handledMigrationIssues StudentMigrationIssue[] @relation("MigrationIssueHandler")
  passwordResetChallenges PasswordResetChallenge[]
}

model RefreshToken {
  id        String    @id
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetChallenge {
  id          String    @id
  userId      String
  targetType  String
  targetValue String
  codeHash    String
  expiresAt   DateTime
  attempts    Int       @default(0)
  usedAt      DateTime?
  requestIp   String?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt, usedAt])
}

model PhoneRegistrationChallenge {
  id          String    @id
  phone       String
  codeHash    String
  expiresAt   DateTime
  attempts    Int       @default(0)
  usedAt      DateTime?
  requestIp   String?
  createdAt   DateTime  @default(now())

  @@index([phone, createdAt])
  @@index([expiresAt, usedAt])
}

model Course {
  id                     String                @id
  title                  String
  subtitle               String?
  category               String
  date                   String
  location               String
  instructor             String
  image                  String?
  price                  Float
  originalPrice          Float?
  specialPrice           Float?
  specialPriceEndsAt     String?
  allowMultiParticipant  Boolean               @default(true)
  maxParticipantsPerOrder Int?
  registrationStartAt    String?
  registrationEndAt      String?
  registrationDeadline   String?
  capacity               Int
  enrolled               Int                   @default(0)
  status                 String
  description            String
  registrationTemplateId String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  registrationTemplate   RegistrationTemplate? @relation(fields: [registrationTemplateId], references: [id], onDelete: SetNull)
  orders                 Order[]
  previews               Preview[]
  enrollments            Enrollment[]

  @@index([registrationTemplateId])
}

model RegistrationTemplate {
  id        String                        @id
  name      String                        @default("报名模板")
  version   Int                           @default(1)
  payload   String
  enabled   Boolean                       @default(true)
  updatedAt DateTime                      @updatedAt
  courses   Course[]
  versions  RegistrationTemplateVersion[]
}

model Order {
  id               String         @id
  userId           String
  courseId         String
  participantCount Int
  participants     String
  originalAmount   Float
  discount         Float
  amount           Float
  status           String
  paymentMethod    String?
  paymentChannel   String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  user             User           @relation(fields: [userId], references: [id])
  course           Course         @relation(fields: [courseId], references: [id])
  paymentProofs    PaymentProof[]
  paymentTransactions PaymentTransaction[]
  enrollments      Enrollment[]

  @@index([userId, createdAt])
  @@index([courseId, status])
}

model PaymentTransaction {
  id               String   @id
  orderId          String
  channel          String
  provider         String
  outTradeNo       String   @unique
  providerTradeNo  String?
  amount           Float
  status           String   @default("pending")
  payload          String   @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  paidAt           DateTime?
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([channel, status, createdAt])
}

model PaymentProof {
  id           String    @id
  orderId      String
  originalName String
  storedName   String
  mimeType     String
  size         Int
  path         String
  status       String    @default("pending")
  remark       String?
  createdAt    DateTime  @default(now())
  reviewedAt   DateTime?
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model Invoice {
  id          String    @id
  userId      String
  orderIds    String
  payload     String
  status      String
  createdAt   DateTime  @default(now())
  processedAt DateTime?
  user        User      @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model Preview {
  id       String   @id
  userId   String
  courseId String
  viewedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model Feedback {
  id        String    @id
  userId    String
  payload   String
  status    String
  createdAt DateTime  @default(now())
  repliedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model PointLedger {
  id        String   @id
  userId    String
  points    Int
  reason    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Message {
  id        String   @id
  payload   String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  reads     MessageRead[]
}

model MessageRead {
  id        String   @id
  messageId String
  userId    String
  readAt    DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, readAt])
}

model AuditLog {
  id        String   @id
  actor     String
  action    String
  detail    String
  beforeJson String?
  afterJson  String?
  createdAt DateTime @default(now())
}

model Banner {
  id        String   @id
  payload   String
  enabled   Boolean  @default(true)
  sort      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PaymentSetting {
  id        String   @id
  payload   String
  updatedAt DateTime @updatedAt
}

model DiscountRule {
  id             String   @id
  minPeople      Int
  discountRate   Float
  scopeCourseIds String   @default("[]")
  enabled        Boolean  @default(true)
  updatedAt      DateTime @updatedAt
}

model SystemConfig {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model Student {
  id               String           @id
  name             String
  phone            String?
  phoneNormalized  String?
  gender           String?
  email            String?
  company          String?
  department       String?
  position         String?
  status           String           @default("active")
  mergedIntoId     String?
  extraPayload     String?
  createdByUserId  String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  mergedInto       Student?         @relation("StudentMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedSources    Student[]        @relation("StudentMerge")
  accountRelations AccountStudent[]
  enrollments      Enrollment[]

  @@index([phoneNormalized])
  @@index([status, updatedAt])
  @@index([mergedIntoId])
}

model StudentMigrationBatch {
  id                 String                 @id
  status             String                 @default("running")
  cursorOrderId     String?
  totalOrders        Int                    @default(0)
  processedOrders    Int                    @default(0)
  createdStudents    Int                    @default(0)
  createdEnrollments Int                    @default(0)
  skippedParticipants Int                   @default(0)
  issueCount         Int                    @default(0)
  summary            String                 @default("{}")
  startedAt          DateTime               @default(now())
  completedAt        DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  issues             StudentMigrationIssue[]

  @@index([status, startedAt])
}

model StudentMigrationIssue {
  id                    String                @id
  batchId               String
  orderId               String?
  sourceParticipantIndex Int?
  issueType             String
  message               String
  rawPayload            String?
  status                String                @default("open")
  handledByUserId       String?
  handledAt             DateTime?
  createdAt             DateTime              @default(now())
  batch                 StudentMigrationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  handledBy             User?                 @relation("MigrationIssueHandler", fields: [handledByUserId], references: [id], onDelete: SetNull)

  @@index([batchId, status])
  @@index([orderId, sourceParticipantIndex])
  @@index([issueType, status])
}

model AccountStudent {
  id              String    @id
  userId          String
  studentId       String
  relationType    String    @default("other")
  isDefault       Boolean   @default(false)
  source          String    @default("user_created")
  status          String    @default("active")
  createdByUserId String?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  student         Student   @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([userId, studentId])
  @@index([userId, status, isDefault])
  @@index([studentId, status])
}

model RegistrationTemplateVersion {
  id              String               @id
  templateId      String
  version         Int
  payload         String
  checksum        String
  status          String               @default("draft")
  createdByUserId String?
  publishedAt     DateTime?
  createdAt       DateTime             @default(now())
  template        RegistrationTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  enrollments     Enrollment[]

  @@unique([templateId, version])
  @@index([templateId, status])
}

model Enrollment {
  id                     String                       @id
  studentId              String
  courseId               String
  orderId                String?
  accountUserId          String
  sourceParticipantIndex Int
  templateVersionId      String?
  templateVersion        Int?
  formPayload            String
  status                 String                       @default("registered")
  registeredAt           DateTime                     @default(now())
  cancelledAt            DateTime?
  completedAt            DateTime?
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  student                Student                      @relation(fields: [studentId], references: [id], onDelete: Restrict)
  course                 Course                       @relation(fields: [courseId], references: [id], onDelete: Restrict)
  order                  Order?                       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  accountUser            User                         @relation("EnrollmentAccountUser", fields: [accountUserId], references: [id], onDelete: Restrict)
  templateVersionRef     RegistrationTemplateVersion? @relation(fields: [templateVersionId], references: [id], onDelete: SetNull)

  @@unique([orderId, sourceParticipantIndex])
  @@index([studentId, registeredAt])
  @@index([courseId, status])
  @@index([accountUserId, registeredAt])
  @@index([templateVersionId])
}
