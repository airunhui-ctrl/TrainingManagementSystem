{
  "name": "hexagon-training-api",
  "private": true,
  "scripts": {
    "start:dev": "nest start --watch",
    "build": "nest build",
    "test": "jest --runInBand",
    "db:generate": "prisma generate",
    "db:migrate": "node prisma/migrate.js",
    "db:prepare:postgres": "node prisma/prepare-postgresql.cjs",
    "db:migrate:postgres": "prisma migrate deploy --schema prisma/postgresql/schema.prisma",
    "db:export:postgres": "node prisma/export-postgresql.cjs",
    "db:import:postgres": "node prisma/import-postgresql.cjs",
    "db:prisma-migrate": "prisma migrate dev --name init",
    "db:seed": "node prisma/seed.js",
    "db:init": "prisma generate && node prisma/migrate.js && node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/schematics": "^10.2.0",
    "@nestjs/testing": "^10.4.0",
    "@types/node": "^22.0.0",
    "jest": "^29.7.0",
    "prisma": "6.12.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.6.0"
  }
}
