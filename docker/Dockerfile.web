FROM node:22-bookworm-slim AS dependencies

WORKDIR /app
RUN corepack enable

# npm and corepack registry mirrors — overridable via --build-arg.
# Defaults to npmmirror (Alibaba) so builds work on servers without npmjs access.
ARG NPM_CONFIG_REGISTRY=https://registry.npmmirror.com
ARG COREPACK_NPM_REGISTRY=https://registry.npmmirror.com
ENV npm_config_registry=${NPM_CONFIG_REGISTRY}
ENV COREPACK_NPM_REGISTRY=${COREPACK_NPM_REGISTRY}

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY backend/api/package.json backend/api/package.json
COPY frontend/admin-react/package.json frontend/admin-react/package.json
COPY frontend/client-uni/package.json frontend/client-uni/package.json
RUN pnpm install --frozen-lockfile
COPY . .

FROM dependencies AS admin-build
ENV VITE_API_BASE_URL=/api
RUN pnpm --dir frontend/admin-react build

FROM dependencies AS h5-build
ENV VITE_API_BASE_URL=/api
RUN pnpm --dir frontend/client-uni build:h5

FROM nginx:1.27-alpine AS admin
COPY docker/nginx/admin.conf /etc/nginx/conf.d/default.conf
COPY --from=admin-build /app/frontend/admin-react/dist /usr/share/nginx/html

FROM nginx:1.27-alpine AS h5
COPY docker/nginx/h5.conf /etc/nginx/conf.d/default.conf
COPY --from=h5-build /app/frontend/client-uni/dist/build/h5 /usr/share/nginx/html
FROM nginx:1.27-alpine AS assessment
COPY docker/nginx/assessment.conf /etc/nginx/conf.d/default.conf
COPY another/index.html /usr/share/nginx/html/index.html