FROM node:22-bookworm-slim AS build

WORKDIR /app
RUN corepack enable

# npm and corepack registry mirrors — overridable via --build-arg.
# Defaults to npmmirror (Alibaba) so builds work on servers without npmjs access.
ARG NPM_CONFIG_REGISTRY=https://registry.npmmirror.com
ARG COREPACK_NPM_REGISTRY=https://registry.npmmirror.com
ENV npm_config_registry=${NPM_CONFIG_REGISTRY}
ENV COREPACK_NPM_REGISTRY=${COREPACK_NPM_REGISTRY}

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY backend/api/package.json backend/api/package.json
COPY frontend/admin-react/package.json frontend/admin-react/package.json
COPY frontend/client-uni/package.json frontend/client-uni/package.json
RUN pnpm install --frozen-lockfile

COPY . .

# Generate a PostgreSQL Prisma Client and migration without contacting a real database.
# The runtime DATABASE_URL is supplied by Compose through .env.docker.
ENV DATABASE_URL=postgresql://training_app:build-only@postgres:5432/training_management?schema=public
RUN pnpm --dir backend/api db:prepare:postgres
RUN pnpm run build:api

FROM node:22-bookworm-slim AS runtime

WORKDIR /app
RUN corepack enable
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*
ENV NODE_ENV=staging

COPY --from=build /app /app

WORKDIR /app/backend/api
EXPOSE 3100
CMD ["node", "dist/main.js"]